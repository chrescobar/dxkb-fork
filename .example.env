# BV-BRC identity endpoints (server-only)
USER_URL=
USER_AUTH_URL=
USER_VERIFICATION_URL=
USER_REGISTER_URL=
USER_PASSWORD_RESET_URL=
DEFAULT_REALM=bvbrc

SERVICES_API_URL=
WORKSPACE_API_URL=
NEXT_PUBLIC_DATA_API=
APP_SERVICE_URL=
MINHASH_SERVICE_URL=

DATA_SERVICE_URL=
SRA_VALIDATION_URL=

BVBRC_WEBSITE_API_URL=
PHYLO_MANIFEST_URL=https://www.bv-brc.org/api/content/phyloxml_trees/manifest.json
# Production should normally use an absolute path to the mounted dataset directory.
NEXTSTRAIN_DATASET_DIR=./data/auspice-datasets

WORKSPACE_GUIDE_URL=

# Shock upload allowed origins (comma-separated node URLs, e.g. https://shock.mg-rast.org)
SHOCK_ORIGINS=

# Contact form email delivery (used by /api/contact).
# All optional — defaults mirror BV-BRC, which sends via the deployment server's
# local mail relay (localhost:25, no auth). Override only if using a remote SMTP.
# Port 465 uses implicit TLS; other ports use STARTTLS.
SMTP_HOST=localhost
SMTP_PORT=25
# SMTP credentials — leave blank for an unauthenticated local relay.
SMTP_USER=
SMTP_PASSWORD=
# Address that receives contact form submissions (default: help@dxkb.org).
CONTACT_EMAIL_TO=
# From address for outgoing contact emails (default: DXKB <do-not-reply@dxkb.org>).
CONTACT_EMAIL_FROM=
